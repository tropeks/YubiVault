<Project Sdk="Microsoft.NET.Sdk">

  <!-- A small CTAP2 client that talks to FIDO2 keys directly, over USB HID or NFC, on any system. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Formats.Cbor" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YubiVault.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YubiVault.Core\YubiVault.Core.csproj" />
  </ItemGroup>

</Project>
