<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YubiVault.Android.App"
             RequestedThemeVariant="Default">
    <!-- Light or dark mode and the accent color follow the phone's settings. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
