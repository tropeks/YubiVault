<UserControl x:Class="YubiVault.App.Pages.VaultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="24,4,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: vault name and lock -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="LockOpen24" FontSize="26" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="VaultName" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="VaultLocation" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon KeyMultiple24}" Content="Keys" Margin="0,0,8,0"
                       Click="OnKeys" />
            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon LockClosed24}" Content="Lock" Appearance="Primary"
                       Click="OnLock" />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="UpButton" Icon="{ui:SymbolIcon ArrowUp24}" Appearance="Transparent"
                           ToolTip="Up one folder" Padding="6" Click="OnUp" />
                <TextBlock x:Name="FolderText" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxWidth="320"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon DocumentAdd24}" Content="Add files" Margin="0,0,6,0" Click="OnAddFiles" />
                <ui:Button Icon="{ui:SymbolIcon FolderAdd24}" Content="Add folder" Margin="0,0,6,0" Click="OnAddFolder" />
                <ui:Button x:Name="ExtractButton" Icon="{ui:SymbolIcon ArrowExport24}" Content="Extract" Margin="0,0,6,0"
                           Click="OnExtract" />
                <ui:Button x:Name="RenameButton" Icon="{ui:SymbolIcon Rename24}" ToolTip="Rename" Margin="0,0,6,0"
                           Click="OnRename" />
                <ui:Button x:Name="DeleteButton" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete" Click="OnDelete" />
            </StackPanel>
        </Grid>

        <!-- Contents -->
        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <ui:ListView x:Name="ItemsList" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                          MouseDoubleClick="OnItemDoubleClick" SelectionChanged="OnSelectionChanged"
                          KeyDown="OnListKeyDown">
                    <ui:ListView.View>
                        <ui:GridView>
                            <ui:GridViewColumn Header="Name" Width="420">
                                <ui:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ui:GridViewColumn.CellTemplate>
                            </ui:GridViewColumn>
                            <ui:GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                            <ui:GridViewColumn Header="Modified" Width="170" DisplayMemberBinding="{Binding ModifiedText}" />
                        </ui:GridView>
                    </ui:ListView.View>
                </ui:ListView>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Drop files or folders here to encrypt them" Margin="0,10,0,0" FontSize="15"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="or use Add files / Add folder above" Margin="0,4,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="AutoLockText" HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
