<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:r="using:YubiVault.App.Resources"
             x:Class="YubiVault.App.Pages.CreatePage">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,4,24,14" ColumnDefinitions="Auto,Auto,*">
            <Button Classes="toolbar" Padding="8" VerticalAlignment="Center" Click="OnBack" ToolTip.Tip="{x:Static r:Strings.Back}">
                <ui:SymbolIcon Symbol="Back" FontSize="16" />
            </Button>
            <Border Grid.Column="1" Classes="tile" Width="44" Height="44" Margin="8,0,0,0">
                <ui:SymbolIcon Symbol="NewFolder" FontSize="22" />
            </Border>
            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static r:Strings.CreateTitle}" Classes="title" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static r:Strings.CreateIntro}" />
            </StackPanel>
        </Grid>

        <Border Classes="layer" BorderThickness="0,1,0,0" CornerRadius="0">
            <ScrollViewer>
                <StackPanel Margin="24,20,24,32" MaxWidth="640" HorizontalAlignment="Left">
                    <Border Classes="card" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="{x:Static r:Strings.Where}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="LocationInput" Watermark="{x:Static r:Strings.WherePlaceholder}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="{x:Static r:Strings.Browse}" Margin="8,0,0,0" Click="OnBrowse" />
                            </Grid>
                            <TextBox x:Name="NameInput" Watermark="{x:Static r:Strings.VaultNamePlaceholder}"
                                     Text="{x:Static r:Strings.DefaultVaultName}" Margin="0,8,0,0" />

                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="20,16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static r:Strings.Key}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <RadioButton x:Name="Fido2Option" GroupName="KeyType" IsChecked="True" IsCheckedChanged="OnKeyTypeChanged">
                                <StackPanel>
                                    <TextBlock Text="{x:Static r:Strings.KeyFido2Title}" />
                                    <TextBlock Text="{x:Static r:Strings.KeyFido2Detail}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="OtpOption" GroupName="KeyType" Margin="0,8,0,0" IsCheckedChanged="OnKeyTypeChanged">
                                <StackPanel>
                                    <TextBlock Text="{x:Static r:Strings.KeyOtpTitle}" />
                                    <TextBlock Text="{x:Static r:Strings.KeyOtpDetail}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>

                            <StackPanel x:Name="OtpPanel" IsVisible="False" Margin="28,12,0,0" Spacing="8">
                                <TextBox x:Name="PasswordInput" Watermark="{x:Static r:Strings.PasswordOptional}" PasswordChar="●"
                                         Classes="revealPasswordButton" />
                                <TextBox x:Name="PasswordRepeat" Watermark="{x:Static r:Strings.RepeatPassword}" PasswordChar="●" />
                                <CheckBox x:Name="ReplaceSlot" Content="{x:Static r:Strings.ReplaceSlot}" />
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <ui:InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Margin="0,24,0,0"
                                Title="{x:Static r:Strings.RecoveryNoticeTitle}" Message="{x:Static r:Strings.RecoveryNoticeText}" />

                    <Button Classes="accent large" Margin="0,20,0,0" Click="OnCreate">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource LockClosedIcon}" Width="16" Height="16" />
                            <TextBlock Text="{x:Static r:Strings.CreateButton}" />
                        </StackPanel>
                    </Button>

                    <ui:InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" Margin="0,16,0,0"
                                Title="{x:Static r:Strings.CouldNotCreate}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
