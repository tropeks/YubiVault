<UserControl x:Class="YubiVault.App.Pages.CreatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,8,40,32" MaxWidth="560" HorizontalAlignment="Left" Width="560">
            <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Content="Back" Appearance="Transparent"
                       Padding="8,4" Margin="-8,0,0,12" Click="OnBack" />
            <TextBlock Text="Create a new vault" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,6,0,24" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="A vault is a single .yvault file. Keep it on a USB stick, a disk or a cloud folder: from the outside nobody sees names, sizes or contents." />

            <TextBlock Text="Where" FontWeight="SemiBold" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="LocationInput" PlaceholderText="Folder where the vault file will be saved" IsReadOnly="True" />
                <ui:Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="OnBrowse" />
            </Grid>
            <ui:TextBox x:Name="NameInput" PlaceholderText="Vault name" Text="My Vault" Margin="0,8,0,0" />

            <TextBlock Text="Key" FontWeight="SemiBold" Margin="0,24,0,6"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <RadioButton x:Name="Fido2Option" GroupName="KeyType" IsChecked="True" Checked="OnKeyTypeChanged">
                <StackPanel>
                    <TextBlock Text="Security key (FIDO2), recommended" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Any YubiKey 5 or Security Key. Windows asks for the key's PIN and a touch."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="OtpOption" GroupName="KeyType" Margin="0,8,0,0" Checked="OnKeyTypeChanged">
                <StackPanel>
                    <TextBlock Text="YubiKey 5 challenge-response (OTP slot 2)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Touch only, with an optional password. Works on Windows 10."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </RadioButton>

            <StackPanel x:Name="OtpPanel" Visibility="Collapsed" Margin="28,12,0,0">
                <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="Password (optional, recommended)" />
                <ui:PasswordBox x:Name="PasswordRepeat" PlaceholderText="Repeat password" Margin="0,8,0,0" />
                <CheckBox x:Name="ReplaceSlot" Margin="0,8,0,0"
                          Content="Program slot 2 with a new secret (erases what is there)" />
            </StackPanel>

            <ui:InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Margin="0,24,0,0"
                        Title="You will get a recovery code"
                        Message="It opens the vault if you lose your key. You will see it once, right after the vault is created." />

            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ShieldLock24}" Content="Create vault"
                       Margin="0,20,0,0" Padding="16,10" Click="OnCreate" />

            <ui:InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" Margin="0,16,0,0"
                        Title="Could not create the vault" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
