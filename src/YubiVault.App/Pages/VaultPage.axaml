<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:r="using:YubiVault.App.Resources"
             xmlns:p="using:YubiVault.App.Pages"
             x:Class="YubiVault.App.Pages.VaultPage"
             DragDrop.AllowDrop="True">
    <DockPanel>
        <!-- Header: vault name and lock, on the window's own surface -->
        <Grid DockPanel.Dock="Top" Margin="24,4,24,14" ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Classes="tile" Width="44" Height="44">
                <PathIcon Data="{StaticResource LockOpenIcon}" Width="22" Height="22" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="VaultName" Classes="title" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="VaultLocation" Classes="caption" TextTrimming="PathSegmentEllipsis" />
            </StackPanel>
            <Button x:Name="KeysButton" Grid.Column="2" Classes="large" Margin="0,0,8,0" Click="OnKeys">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource KeyIcon}" Width="16" Height="16" />
                    <TextBlock Text="{x:Static r:Strings.Keys}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="accent large" Click="OnLock">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource LockClosedIcon}" Width="16" Height="16" />
                    <TextBlock Text="{x:Static r:Strings.Lock}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Classes="layer" BorderThickness="0,1,0,0" CornerRadius="0">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Toolbar: where we are, and what can be done here -->
                <Grid Margin="16,12,16,10" ColumnDefinitions="Auto,*,Auto">
                    <Button x:Name="UpButton" Classes="toolbar" Padding="8" Click="OnUp"
                            ToolTip.Tip="{x:Static r:Strings.UpOneFolder}">
                        <ui:SymbolIcon Symbol="Up" FontSize="16" />
                    </Button>
                    <ItemsControl x:Name="Breadcrumbs" Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="p:Breadcrumb">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChevronRight" FontSize="12" Margin="2,0" IsVisible="{Binding !IsFirst}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Button Classes="toolbar" Padding="6,4" Tag="{Binding Path}" Click="OnBreadcrumb"
                                            IsHitTestVisible="{Binding !IsLast}">
                                        <TextBlock Text="{Binding Name}" FontSize="15" MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontWeight="{Binding Weight}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Classes="toolbar" Click="OnAddFiles">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Add" FontSize="16" />
                                <TextBlock Text="{x:Static r:Strings.AddFiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar" Click="OnAddFolder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="NewFolder" FontSize="16" />
                                <TextBlock Text="{x:Static r:Strings.AddFolder}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExtractButton" Classes="toolbar" Click="OnExtract">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Download" FontSize="16" />
                                <TextBlock Text="{x:Static r:Strings.Extract}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <Button x:Name="RenameButton" Classes="toolbar" Padding="8" Click="OnRename"
                                ToolTip.Tip="{x:Static r:Strings.Rename}">
                            <ui:SymbolIcon Symbol="Rename" FontSize="16" />
                        </Button>
                        <Button x:Name="DeleteButton" Classes="toolbar" Padding="8" Click="OnDelete"
                                ToolTip.Tip="{x:Static r:Strings.Delete}">
                            <ui:SymbolIcon Symbol="Delete" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Contents -->
                <Border Grid.Row="1" Classes="card" Margin="16,0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Margin="20,10,20,8" ColumnDefinitions="*,110,170">
                            <TextBlock Text="{x:Static r:Strings.ColumnName}" Classes="header" Margin="40,0,0,0" />
                            <TextBlock Grid.Column="1" Text="{x:Static r:Strings.ColumnSize}" Classes="header" />
                            <TextBlock Grid.Column="2" Text="{x:Static r:Strings.ColumnModified}" Classes="header" />
                        </Grid>
                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <ListBox x:Name="ItemsList" Grid.Row="2" Classes="rows" SelectionMode="Multiple"
                                 Background="Transparent" Padding="0,4"
                                 DoubleTapped="OnItemDoubleTapped" SelectionChanged="OnSelectionChanged"
                                 KeyDown="OnListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="p:VaultItem">
                                    <Grid ColumnDefinitions="*,110,170" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="{Binding IconBackground}">
                                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16"
                                                               Foreground="{Binding IconBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" Spacing="6">
                            <Border Classes="tile" Width="72" Height="72" CornerRadius="36" Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Download" FontSize="32" />
                            </Border>
                            <TextBlock Text="{x:Static r:Strings.DropHere}" Classes="subtitle" FontSize="16"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Static r:Strings.DropHereDetail}" Classes="body"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Shown while files are dragged over the window. -->
                <Border x:Name="DropOverlay" Grid.Row="1" Margin="16,0" CornerRadius="8" IsVisible="False"
                        IsHitTestVisible="False" BorderThickness="2"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.12" />
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ui:SymbolIcon Symbol="Download" FontSize="40"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Static r:Strings.DropHere}" Classes="subtitle" FontSize="16" />
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Grid Grid.Row="2" Margin="20,10,20,12" ColumnDefinitions="Auto,*,Auto,Auto">
                    <PathIcon Data="{StaticResource LockClosedIcon}" Width="14" Height="14"
                              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="8,0,12,0" Classes="caption"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ui:SymbolIcon Grid.Column="2" Symbol="Clock" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="AutoLockText" Grid.Column="3" Classes="caption" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
