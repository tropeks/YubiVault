<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:r="using:YubiVault.App.Resources"
             xmlns:p="using:YubiVault.App.Pages"
             x:Class="YubiVault.App.Pages.KeysPage">
    <Grid Margin="24,16,24,20" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button Classes="transparent" Padding="6" Click="OnBack" ToolTip.Tip="{x:Static r:Strings.Back}">
                <ui:SymbolIcon Symbol="Back" />
            </Button>
            <PathIcon Data="{StaticResource KeyIcon}" Width="22" Height="22" VerticalAlignment="Center"
                      Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="{x:Static r:Strings.KeysTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12" Text="{x:Static r:Strings.KeysIntro}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid RowDefinitions="Auto,*">
                <Grid Margin="16,8,16,6" ColumnDefinitions="*,150,110">
                    <TextBlock Text="{x:Static r:Strings.ColumnKey}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Static r:Strings.ColumnType}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{x:Static r:Strings.ColumnAdded}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListBox x:Name="SlotsList" Grid.Row="1" Background="Transparent" SelectionMode="Single"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="p:SlotRow">
                            <Grid ColumnDefinitions="*,150,110">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Kind}" />
                                <TextBlock Grid.Column="2" Text="{Binding Added}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Margin="0,0,8,8" Click="OnAddSecurityKey">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:SymbolIcon Symbol="Add" />
                    <TextBlock Text="{x:Static r:Strings.AddSecurityKey}" />
                </StackPanel>
            </Button>
            <Button Margin="0,0,8,8" Click="OnAddOtpKey">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:SymbolIcon Symbol="Add" />
                    <TextBlock Text="{x:Static r:Strings.AddOtpKey}" />
                </StackPanel>
            </Button>
            <Button x:Name="RemoveButton" Margin="0,0,8,8" IsEnabled="False" Click="OnRemove">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:SymbolIcon Symbol="Delete" />
                    <TextBlock Text="{x:Static r:Strings.Remove}" />
                </StackPanel>
            </Button>
            <Button Margin="0,0,8,8" Click="OnNewRecoveryCode">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:SymbolIcon Symbol="Permissions" />
                    <TextBlock Text="{x:Static r:Strings.NewRecoveryCode}" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0" Spacing="10">
            <TextBlock Text="{x:Static r:Strings.LockAfter}" VerticalAlignment="Center" />
            <ComboBox x:Name="AutoLockCombo" MinWidth="160" SelectionChanged="OnAutoLockChanged" />
        </StackPanel>

        <ui:InfoBar x:Name="ErrorBar" Grid.Row="5" Severity="Error" IsClosable="True" Margin="0,12,0,0"
                    Title="{x:Static r:Strings.ErrorTitle}" />
    </Grid>
</UserControl>
