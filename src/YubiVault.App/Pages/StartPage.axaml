<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:r="using:YubiVault.App.Resources"
             x:Class="YubiVault.App.Pages.StartPage">
    <Grid Margin="40,24,40,32" ColumnDefinitions="*,40,*">
        <!-- Left: brand and actions -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="440">
            <Image Source="/Assets/yubivault.png" Width="64" Height="64" HorizontalAlignment="Left" />
            <TextBlock Text="YubiVault" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock Margin="0,6,0,24" TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static r:Strings.AppTagline}" />

            <Button Classes="accent" HorizontalAlignment="Stretch" Padding="12,10" Click="OnOpenVault">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:SymbolIcon Symbol="OpenFolder" />
                    <TextBlock Text="{x:Static r:Strings.OpenVault}" />
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" Padding="12,10" Margin="0,8,0,0" Click="OnCreateVault">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:SymbolIcon Symbol="NewFolder" />
                    <TextBlock Text="{x:Static r:Strings.CreateVault}" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="RecentHeader" Text="{x:Static r:Strings.RecentVaults}" Margin="0,28,0,8"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                Padding="12,8" Tag="{Binding}" Click="OnRecentClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource LockClosedIcon}" Width="16" Height="16" />
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,20,0,0">
                <HyperlinkButton x:Name="AssociateButton" Padding="0" Click="OnAssociate"
                                    Content="{x:Static r:Strings.AssociateFiles}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <ui:SymbolIcon Symbol="Globe" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageCombo" MinWidth="200" SelectionChanged="OnLanguageChanged" />
            </StackPanel>
        </StackPanel>

        <!-- Right: unlock panel for the chosen vault -->
        <Border x:Name="UnlockPanel" Grid.Column="2" VerticalAlignment="Center" IsVisible="False"
                Padding="28" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource LockClosedIcon}" Width="26" Height="26"
                              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="VaultName" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="VaultLocation" Margin="0,6,0,20" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <TextBlock x:Name="UnlockHint" TextWrapping="Wrap" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBox x:Name="PasswordInput" Watermark="{x:Static r:Strings.Password}" PasswordChar="●"
                         Classes="revealPasswordButton" Margin="0,0,0,12" IsVisible="False" KeyDown="OnUnlockKeyDown" />

                <TextBox x:Name="RecoveryInput" Watermark="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"
                         FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" Margin="0,0,0,12"
                         IsVisible="False" KeyDown="OnUnlockKeyDown" />

                <Button x:Name="UnlockButton" Classes="accent" HorizontalAlignment="Stretch" Padding="12,10"
                        Click="OnUnlock">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource LockOpenIcon}" Width="16" Height="16" />
                        <TextBlock Text="{x:Static r:Strings.Unlock}" />
                    </StackPanel>
                </Button>

                <HyperlinkButton x:Name="RecoveryToggle" Margin="0,12,0,0" Padding="0" Click="OnToggleRecovery" />
                <HyperlinkButton x:Name="HiddenToggle" Margin="0,8,0,0" Padding="0" Click="OnToggleHidden" />

                <ui:InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" Margin="0,16,0,0"
                            Title="{x:Static r:Strings.CouldNotOpen}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
