<ui:FluentWindow x:Class="YubiVault.App.RecoveryCodeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Recovery code" Width="560" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar Title="Recovery code" ShowMinimize="False" ShowMaximize="False" ShowClose="False" />
        <StackPanel Margin="28,8,28,24">
            <TextBlock Text="Save your recovery code" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="This code opens the vault if you lose your key. Write it down or print it and keep it somewhere safe and offline. Anyone who has it can open the vault. It will not be shown again." />
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="20" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
            <ui:Button Icon="{ui:SymbolIcon Copy24}" Content="Copy" Margin="0,8,0,0" Click="OnCopy" />
            <CheckBox x:Name="SavedCheck" Margin="0,20,0,0" Content="I have saved the recovery code"
                      Checked="OnSavedChanged" Unchecked="OnSavedChanged" />
            <ui:Button x:Name="ContinueButton" Appearance="Primary" Content="Continue" IsEnabled="False"
                       HorizontalAlignment="Right" Padding="20,8" Margin="0,16,0,0" Click="OnContinue" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
