<ui:FluentWindow x:Class="YubiVault.App.TextPromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,20">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBox x:Name="Input" KeyDown="OnKeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                <ui:Button Content="OK" Appearance="Primary" Padding="20,6" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
