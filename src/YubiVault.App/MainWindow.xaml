<ui:FluentWindow x:Class="YubiVault.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="YubiVault"
                 Width="980" Height="660" MinWidth="720" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="YubiVault">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/yubivault-titlebar.png" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" />

        <!-- Busy overlay: shown while the vault works or waits for a touch. -->
        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
              Background="#B0000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,28" CornerRadius="8"
                    MinWidth="320" MaxWidth="460"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <ui:SymbolIcon x:Name="TouchIcon" Symbol="Fingerprint24" FontSize="48" Margin="0,0,0,12"
                                   HorizontalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <ui:ProgressRing x:Name="BusyRing" IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,16"
                                     HorizontalAlignment="Center" />
                    <TextBlock x:Name="BusyTitle" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="BusyDetail" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="40"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
