<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YubiVault</AssemblyName>
    <RootNamespace>YubiVault.App</RootNamespace>
    <Product>YubiVault</Product>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\..\assets\yubivault.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- One portable executable per system: runtime and native libraries inside, nothing to install. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\yubivault.ico" Link="Assets\yubivault.ico" />
    <AvaloniaResource Include="..\..\assets\yubivault.png" Link="Assets\yubivault.png" />
    <AvaloniaResource Include="..\..\assets\yubivault-file.ico" Link="Assets\yubivault-file.ico" />
    <AvaloniaResource Include="..\..\assets\yubivault-file.png" Link="Assets\yubivault-file.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>YubiVault.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.1" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YubiVault.Core\YubiVault.Core.csproj" />
    <ProjectReference Include="..\YubiVault.YubiKey\YubiVault.YubiKey.csproj" />
  </ItemGroup>

</Project>
