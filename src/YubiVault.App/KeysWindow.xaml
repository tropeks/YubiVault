<ui:FluentWindow x:Class="YubiVault.App.KeysWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Keys and settings" Width="620" Height="560" MinHeight="420"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Keys and settings" ShowMinimize="False" ShowMaximize="False" />
        <Grid Grid.Row="1" Margin="24,4,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Each key below can open this vault on its own. Register a second key as a backup; nothing is re-encrypted." />

            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ui:ListView x:Name="SlotsList" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                          SelectionChanged="OnSelectionChanged">
                    <ui:ListView.View>
                        <ui:GridView>
                            <ui:GridViewColumn Header="Key" Width="300" DisplayMemberBinding="{Binding Label}" />
                            <ui:GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Kind}" />
                            <ui:GridViewColumn Header="Added" Width="110" DisplayMemberBinding="{Binding Added}" />
                        </ui:GridView>
                    </ui:ListView.View>
                </ui:ListView>
            </Border>

            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Add security key" Margin="0,0,8,8" Click="OnAddSecurityKey" />
                <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Add YubiKey (OTP)" Margin="0,0,8,8" Click="OnAddOtpKey" />
                <ui:Button x:Name="RemoveButton" Icon="{ui:SymbolIcon Delete24}" Content="Remove" Margin="0,0,8,8"
                           IsEnabled="False" Click="OnRemove" />
                <ui:Button Icon="{ui:SymbolIcon KeyReset24}" Content="New recovery code" Margin="0,0,8,8"
                           Click="OnNewRecoveryCode" />
            </WrapPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Lock automatically after" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ComboBox x:Name="AutoLockCombo" Width="160" SelectionChanged="OnAutoLockChanged" />
            </StackPanel>

            <ui:InfoBar x:Name="ErrorBar" Grid.Row="4" Severity="Error" IsClosable="True" Margin="0,12,0,0"
                        Title="Something went wrong" />
        </Grid>
    </Grid>
</ui:FluentWindow>
